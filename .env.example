E2B_API_KEY=your_e2b_api_key
OPENAI_API_KEY=your_openai_api_key
# Desktop sandbox backend (defaults to e2b)
# SANDBOX_PROVIDER=e2b
# SANDBOX_PROVIDER=docker
# Optional: override the image used by SANDBOX_PROVIDER=docker
# SKATE_DOCKER_IMAGE=skate-desktop:latest
# Google Tag Manager container ID (set in the deploy environment)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# Model backend: "openai" (default) or "local" (OpenAI-compatible chat completions)
# MODEL_PROVIDER=local
# Required when MODEL_PROVIDER=local. Examples:
#   Ollama:     http://localhost:11434/v1
#   Open WebUI: http://localhost:3000/api   (use a different port than this app)
#   vLLM:       http://localhost:8000/v1
#   llama.cpp:  http://localhost:8080/v1
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=gemma3:12b
# LOCAL_LLM_API_KEY=not-needed
# Set to false if your server rejects response_format: json_object
# LOCAL_LLM_JSON_MODE=true
# SANDBOX_PROVIDER=playwright runs Chromium on the host (no Docker).
# Install the browser once: npx playwright install chromium
# SKATE_PLAYWRIGHT_START_URL=https://duckduckgo.com
# A visible browser window opens by default; set true for tests/CI (auto-headless without a display)
# SKATE_PLAYWRIGHT_HEADLESS=true
